# Copier ce fichier en .env.local et le remplir.
# En local : valeurs affichées par `npx supabase start` (API URL et Publishable key).
# En production (Vercel) : celles du projet Supabase de KFFR contrée (Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Import du contenu (npm run content:import) uniquement : lus par le script, jamais par le site.
# Clé secrète (Settings → API Keys → Secret key, ou « Secret key » de `npx supabase start` en local).
# Ne jamais la préfixer par NEXT_PUBLIC_, ne jamais la commiter.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=
