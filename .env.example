# Copier ce fichier en .env.local et le remplir.
# En local : valeurs affichées par `npx supabase start` (API URL et Publishable key).
# En production (Vercel) : celles du projet Supabase de KFFR contrée (Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
